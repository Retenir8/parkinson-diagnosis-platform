{
  "name": "multimodal-clinical-assessment",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:backend": "cd ../../server && .venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "dev:browser": "concurrently -k -n API,WEB -c cyan,blue \"npm:dev:backend\" \"npm:dev:web\"",
    "dev:desktop": "concurrently -k -n API,DESKTOP -c cyan,magenta \"npm:dev:backend\" \"npm:tauri:dev\"",
    "tauri:dev": "tauri dev",
    "build": "vue-tsc -b && vite build",
    "build:desktop": "tauri build",
    "typecheck": "vue-tsc -b",
    "tauri": "tauri"
  },
  "dependencies": {
    "@lucide/vue": "^1.27.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "concurrently": "^9.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
